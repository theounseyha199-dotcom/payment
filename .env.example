# Keycloak local administrator (used only by Docker Compose)
KC_BOOTSTRAP_ADMIN_PASSWORD=change-this-local-password

# Private service-to-service credential; never send it from the browser.
INTERNAL_SERVICE_TOKEN=change-this-service-token

# Bakong credentials are used only by payment-service.
BAKONG_ACCOUNT_ID=your-bakong-account-id
BAKONG_MERCHANT_NAME=Your Merchant Name
BAKONG_CURRENCY=KHR
BAKONG_TOKEN=your-bakong-access-token
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
